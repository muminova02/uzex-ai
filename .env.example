# Copy to .env (git-ignored). This template contains no credentials.
# Only UZEX_* variables are read; GROQ_*/ANTHROPIC_* are ignored.
# Do not put inline comments after the API key value. In Docker this file is bind-mounted read-only and parsed
# by the app; variables set in docker-compose.yml `environment:` (paths, limits) take precedence over it.

# --- LLM: leave disabled for offline dashboard/fixture work; choose one provider explicitly ---
UZEX_LLM_PROVIDER=none
UZEX_LLM_API_KEY=
UZEX_LLM_MODEL=claude-opus-5-5
UZEX_LLM_EFFORT=low
UZEX_LLM_TIMEOUT_S=30
UZEX_LLM_MAX_ATTEMPTS=3

# --- Anthropic (the current deployed build uses this provider; requires your own key) ---
# UZEX_LLM_PROVIDER=anthropic
# UZEX_LLM_MODEL=claude-opus-5-5
# UZEX_LLM_FALLBACKS=true

# --- Groq (alternative; not selected automatically) ---
# UZEX_LLM_PROVIDER=groq
# UZEX_LLM_MODEL=openai/gpt-oss-120b

# UZEX_LLM_BASE_URL=            # empty = the provider's official endpoint

# --- Telegram bot ---
UZEX_BOT_TOKEN=
UZEX_BOT_MAX_CONCURRENT=2
UZEX_BOT_MAX_WAITING=20
UZEX_BOT_SESSION_TTL_S=600
UZEX_TG_RICH_TABLES=false

# --- web (FastAPI serves web/dist and /api on one origin) ---
UZEX_WEB_HOST=127.0.0.1
UZEX_WEB_PORT=8000
# shared LLM quota gate: every process using the same key (web, bot, scripts) must point to the SAME file
UZEX_LLM_GATE_PATH=./data/llm_gate.sqlite
# Question journaling includes question text and network identifiers. Enable only with a retention policy.
UZEX_QUESTION_LOG_ENABLED=false

# --- request limits (the budget includes queue time and rate-limit waits) ---
UZEX_REQUEST_BUDGET_S=70
UZEX_SQL_TIMEOUT_S=20
UZEX_SQL_WORKERS=2
UZEX_MAX_RESULT_ROWS=200
# UZEX_DATA_DIR=./uzex_spot_data
# UZEX_DB_PATH=./data/uzex.duckdb

# --- deployment (Prompt 7) ---
# Runtime processes never import; run `python -m uzex_assistant.importer ensure` (or `docker compose run --rm import`).
UZEX_RUNTIME_IMPORT=false
# Submission freeze: after it the import CLI refuses new ingestion; after scripts/freeze.py the runtimes refuse a
# different build/prompt. Set to true ONLY for an organizer-approved change.
# UZEX_FREEZE_AT=2026-11-05T18:00:00+05:00
UZEX_ALLOW_AFTER_FREEZE=false
# UZEX_FREEZE_PATH=                 # default: <db dir>/FREEZE.json
# UZEX_BOT_HEARTBEAT_PATH=          # set by docker-compose (container health check)
# UZEX_BUILD_INFO_PATH=             # set by the image (/app/BUILD_INFO.json)
